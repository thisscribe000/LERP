# Required to access the organiser dashboard. Do not commit your real values.
LERP_ADMIN_PASSWORD=replace-with-a-long-unique-password
# Optional: a separate secret used to sign admin sessions. If omitted, the
# password is used as the signing key for local development.
LERP_SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000

# Supabase configuration for cloud storage & multi-instance deployment
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
